# Merriam-Webster Dictionary API (https://dictionaryapi.com/register/index)

# Free tier: 1,000 requests/day

MERRIAM_WEBSTER_API_KEY=your-api-key-here

MERRIAM_WEBSTER_DAILY_LIMIT=1000



# Oxford Dictionaries API v2 (https://developer.oxforddictionaries.com/)

# Register for app_id and app_key. Free/sandbox tier: 500 requests/day.

OXFORD_DICTIONARIES_APP_ID=your-app-id-here

OXFORD_DICTIONARIES_APP_KEY=your-app-key-here

OXFORD_DICTIONARIES_DAILY_LIMIT=500

# Language: en-us | en-gb | en

OXFORD_DICTIONARIES_LANGUAGE=en-gb

# Production (default):

# OXFORD_DICTIONARIES_API_BASE=https://od-api.oxforddictionaries.com/api/v2

# Sandbox (for testing):

OXFORD_DICTIONARIES_API_BASE=https://od-api-sandbox.oxforddictionaries.com/api/v2



# Backend server

PORT=8000



# Optional CORS (comma-separated origins, or * for all)

# CORS_ORIGINS=http://localhost:4200



# ---------------------------------------------------------------------------

# Nhost (PostgreSQL + Hasura) — word dictionary cache

# Dashboard: https://app.nhost.io → your project → Settings

# ---------------------------------------------------------------------------

# Master switch: connect to Nhost Postgres / Hasura

USE_NHOST=false

# Read from Nhost first on /words/validate (skip external APIs when cache is complete)

USE_NHOST_CACHE=true

# Write portal lookups and enrichment results back to Nhost (insert + update)

USE_NHOST_SAVE=true



# ---------------------------------------------------------------------------

# Portal / UI dictionary sources (/words/validate)

# Set each to true or false. Requires API keys where noted.

# ---------------------------------------------------------------------------

# Master switch for web scrapers (when false, both scrapers below are skipped)

UI_USE_SCRAPER_FALLBACK=true

# Quota APIs (need keys above)

UI_ALLOW_MERRIAM_WEBSTER=true

UI_ALLOW_OXFORD_DICTIONARIES_API=true

UI_ALLOW_WORDS_API_RAPIDAPI=true

# Free REST APIs (no key)

UI_ALLOW_DICTIONARY_API_DEV=true

UI_ALLOW_FREE_DICTIONARY_API_COM=true

UI_ALLOW_WORD_GAME_DB=true

UI_ALLOW_DATAMUSE=true

# Web scrapers (used on cache miss when UI_USE_SCRAPER_FALLBACK=true)

UI_ALLOW_OXFORD_WEB_SCRAPER=true

UI_ALLOW_FREEDICTIONARY=true

# Enrich synonyms via DataMuse (free); Merriam-Webster thesaurus uses daily quota

UI_ENRICH_SYNONYMS=true

UI_USE_MERRIAM_FOR_SYNONYMS=false

# Return Nhost hits immediately; fill missing fields in a background task (no UI wait)

UI_BACKGROUND_ENRICH=true



# ---------------------------------------------------------------------------

# Bulk enrichment (scripts/enrich_words_in_nhost.py)

# ---------------------------------------------------------------------------

ENRICH_ALLOW_MERRIAM_WEBSTER=true

ENRICH_ALLOW_OXFORD_DICTIONARIES_API=true

ENRICH_ALLOW_DICTIONARY_API_DEV=true

ENRICH_ALLOW_FREE_DICTIONARY_API_COM=true

ENRICH_ALLOW_WORDS_API_RAPIDAPI=true

ENRICH_ALLOW_WORD_GAME_DB=true

ENRICH_ALLOW_DATAMUSE=true

ENRICH_ALLOW_OXFORD_WEB=true

ENRICH_ALLOW_FREEDICTIONARY=true

ENRICH_SYNONYMS=true

ENRICH_USE_MERRIAM_FOR_SYNONYMS=false

ENRICH_FREEDICTIONARY_DELAY=3.0

ENRICH_OXFORD_WEB_CONCURRENCY=2



# Free Dictionary API (dictionaryapi.dev) — optional tuning

# DICTIONARY_API_DEV_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# DICTIONARY_API_DEV_DELAY=0.15



# Free Dictionary API (freedictionaryapi.com) — optional tuning

# FREE_DICTIONARY_API_COM_BASE_URL=https://freedictionaryapi.com/api/v1/entries/en

# FREE_DICTIONARY_API_COM_DELAY=0.2



# Words API via RapidAPI (https://rapidapi.com/dpventures/api/wordsapi)

# GET https://wordsapiv1.p.rapidapi.com/words/{word}

WORDS_API_RAPIDAPI_KEY=your-rapidapi-key-here

# WORDS_API_RAPIDAPI_HOST=wordsapiv1.p.rapidapi.com

# WORDS_API_RAPIDAPI_BASE_URL=https://wordsapiv1.p.rapidapi.com

# WORDS_API_RAPIDAPI_DELAY=0.35

# Fetch synonyms, rhymes, frequency (and /effect if supported) on word lookup

WORDS_API_RAPIDAPI_ENRICH_DETAILS=true



# Word Game DB (https://www.wordgamedb.com/api/v2) — no API key required

WORD_GAME_DB_ENABLED=true

WORD_GAME_DB_BASE_URL=https://www.wordgamedb.com/api/v2

# WORD_GAME_DB_DELAY=0.2



# DataMuse (https://api.datamuse.com) — free word-finding API, no key required until 2027

DATAMUSE_ENABLED=true

DATAMUSE_BASE_URL=https://api.datamuse.com

# DATAMUSE_API_KEY=

# DATAMUSE_DELAY=0.15



# Daily scrambled-word puzzle cache file (server-side, rotates each calendar day)

# DAILY_SCRAMBLE_CACHE_FILE=backend/data/daily_scramble_cache.json



# From Nhost project settings (Overview)

NHOST_SUBDOMAIN=your-subdomain

NHOST_REGION=us-east-1



# Database → Connection string (required for bulk import script)

# Prefer the pooled connection string from Nhost Dashboard if available.

NHOST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_HOST.nhost.run:5432/YOUR_DB

# Connection resilience (cloud Postgres can drop idle/direct connections)

# NHOST_DB_POOL_MAX=4

# NHOST_DB_CONNECT_RETRIES=3



# Hasura admin secret (Settings → Secrets). Optional if using DATABASE_URL only.

NHOST_ADMIN_SECRET=your-hasura-admin-secret



# Auto-built if omitted: https://{NHOST_SUBDOMAIN}.graphql.{NHOST_REGION}.nhost.run/v1

# NHOST_GRAPHQL_URL=https://your-subdomain.graphql.us-east-1.nhost.run/v1



# Table name (default: words)

# NHOST_WORDS_TABLE=words



# Load word list from Nhost instead of words.txt (optional)

# STORAGE_TYPE=nhost

